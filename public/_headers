/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
# Vite content-hashes every file under /assets, so a changed file always has a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/models/*
  Cache-Control: public, max-age=86400, must-revalidate
/anatomy/*
  Cache-Control: public, max-age=3600, must-revalidate
# Cloudflare only compresses listed content types; application/octet-stream is not one.
# The quantized geometry buffers are read with fetch().arrayBuffer(), never interpreted by type.
/anatomy/*.bin
  Content-Type: application/x-protobuf
/mediapipe/*
  Cache-Control: public, max-age=86400, must-revalidate
# Preserve third-party license documents byte-for-byte on custom domains.
/licenses/*
  Cache-Control: public, max-age=3600, must-revalidate, no-transform
/version.json
  Cache-Control: no-store
