{
  "name": "3d-anatomy-camera",
  "version": "3.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/prepare-assets.mjs && vite build && node scripts/check-size.mjs",
    "preview": "vite preview --host",
    "fetch:models": "node scripts/fetch-models.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "node scripts/check-source.mjs",
    "check": "npm run lint && npm test && npm run build && npm run e2e",
    "verify:deploy": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
